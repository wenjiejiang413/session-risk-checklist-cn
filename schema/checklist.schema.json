{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixlivo.com/schemas/session-risk-checklist-cn-v1.json",
  "title": "Session Risk Checklist CN",
  "type": "object",
  "required": ["id", "version", "language", "updated", "disclaimer", "thresholds", "questions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "language": { "const": "zh-CN" },
    "updated": { "type": "string", "format": "date" },
    "disclaimer": { "type": "string", "minLength": 1 },
    "thresholds": {
      "type": "object",
      "required": ["high", "check"],
      "additionalProperties": false,
      "properties": {
        "high": { "type": "integer", "minimum": 1 },
        "check": { "type": "integer", "minimum": 1 }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "options"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "question": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["value", "label", "weight"],
              "additionalProperties": false,
              "properties": {
                "value": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "weight": { "type": "integer", "minimum": 0 },
                "critical": { "type": "boolean" },
                "note": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
